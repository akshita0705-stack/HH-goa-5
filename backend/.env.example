# --- LLM (required) ---------------------------------------------------------
# Get a key at https://console.anthropic.com/ and paste it below.
ANTHROPIC_API_KEY=
# Any Claude model id your key can access.
LLM_MODEL=claude-sonnet-5-5

# --- Models (optional) ------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Whisper size: tiny | base | small. "base" is a good CPU speed/accuracy trade-off.
WHISPER_MODEL=base
WHISPER_LANGUAGE=en

# --- OCR (optional) ---------------------------------------------------------
# Only needed if `tesseract` is not on your PATH (typical on Windows), e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=eng

# --- Retrieval / limits (optional) -----------------------------------------
TOP_K=5
# Cosine distance cut-off. Passages farther than this are ignored.
MAX_DISTANCE=1.0
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
